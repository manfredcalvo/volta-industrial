{
  "name": "volta-plant-floor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "tsx watch --env-file-if-exists=.env server/server.ts",
    "db:generate": "drizzle-kit generate",
    "prebuild": "npm run db:generate",
    "build": "npm run build:source",
    "build:source": "tsdown && vite build --config client/vite.config.ts",
    "start": "node dist/server.js",
    "typegen": "appkit generate-types",
    "lint": "appkit lint",
    "test": "playwright test"
  },
  "dependencies": {
    "@databricks/appkit": "0.66.1",
    "@openai/agents": "^0.17.0",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.2",
    "express": "4.22.2",
    "jsonc-parser": "^3.3.1",
    "mlflow-tracing": "0.1.3",
    "openai": "^7.2.0",
    "pg": "8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@databricks/appkit-ui": "0.66.1",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^9.0.1",
    "react-router": "^7.0.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "^0.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vite": "npm:rolldown-vite@^7.1.14",
    "vitest": "^3.0.0"
  }
}
