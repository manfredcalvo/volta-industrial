{
  "datasets": [
    {
      "name": "ds_exposure",
      "displayName": "Exposure (metric view)",
      "queryLines": [
        "SELECT plant_id, machine_type, risk_band, criticality,",
        " MEASURE(downtime_exposure) AS downtime_exposure_usd,",
        " MEASURE(open_work_orders) AS open_work_orders,",
        " MEASURE(critical_count) AS critical_count,",
        " MEASURE(atrisk_count) AS atrisk_count,",
        " MEASURE(line_count) AS line_count",
        " FROM serverless_stable_casaman_catalog.dev_manffred_calvosanchez_volta_industrial.mv_line_risk GROUP BY ALL"
      ]
    },
    {
      "name": "ds_lines",
      "displayName": "Lines (current status)",
      "queryLines": [
        "SELECT line_id, plant_id, machine_type, criticality, plant_lat, plant_lng, risk_band,",
        " failure_risk_score, vibration_rms, temperature_c, open_wo_count, downtime_exposure_usd",
        " FROM serverless_stable_casaman_catalog.dev_manffred_calvosanchez_volta_industrial.gold_line_status"
      ]
    },
    {
      "name": "ds_maintenance",
      "displayName": "Maintenance recommendations",
      "queryLines": [
        "SELECT r.line_id, a.plant_id, r.recommended_action,",
        " r.predicted_downtime_cost_avoided_usd, r.predicted_net_value_usd",
        " FROM serverless_stable_casaman_catalog.dev_manffred_calvosanchez_volta_industrial.gold_maintenance_recommendations r",
        " LEFT JOIN serverless_stable_casaman_catalog.dev_manffred_calvosanchez_volta_industrial.gold_open_atrisk a USING (line_id)",
        " ORDER BY r.predicted_net_value_usd DESC"
      ]
    },
    {
      "name": "ds_worst",
      "displayName": "Highest exposure lines",
      "queryLines": [
        "SELECT line_id, plant_id, machine_type, vibration_rms, failure_risk_score, downtime_exposure_usd",
        " FROM serverless_stable_casaman_catalog.dev_manffred_calvosanchez_volta_industrial.gold_line_status WHERE risk_band IN ('critical','elevated')",
        " ORDER BY downtime_exposure_usd DESC"
      ]
    },
    {
      "name": "ds_watch",
      "displayName": "Watch list",
      "queryLines": [
        "SELECT line_id, plant_id, failure_risk_score, open_wo_count",
        " FROM serverless_stable_casaman_catalog.dev_manffred_calvosanchez_volta_industrial.gold_line_status WHERE risk_band='watch' ORDER BY failure_risk_score DESC"
      ]
    }
  ],
